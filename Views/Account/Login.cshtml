@model LoginViewModel
@{
    ViewData["Title"] = "Staff sign in";
}

<div class="narrow" style="max-width:440px">
    <h1>Staff sign in</h1>
    <form asp-action="Login" method="post" class="panel" novalidate>
        <div asp-validation-summary="All" class="alert alert-error"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="grid">
            <div class="full">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" required />
            </div>
            <div class="full">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" autocomplete="current-password" required />
            </div>
            <div class="full">
                <button type="submit" class="btn">Sign in</button>
            </div>
        </div>
    </form>
</div>
